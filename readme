http://localhost/de-grand-hotel/admin/edit_room.php?id=11
<?php
session_start();
if (!isset($_SESSION['admin_logged_in'])) {
    header('Location: login.php');
    exit();
}

require_once '../includes/db_connect.php';

$id = (int)($_GET['id'] ?? 0);
if ($id <= 0) {
    header('Location: room_management.php');
    exit();
}

// Fetch room data
$stmt = $pdo->prepare("SELECT * FROM room_inventory WHERE id = ?");
$stmt->execute([$id]);
$room = $stmt->fetch(PDO::FETCH_ASSOC);

if (!$room) {
    die("Room not found!");
}

$success = $error = '';

// Handle form submission
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $total_rooms     = (int)$_POST['total_rooms'];
    $occupied_rooms  = (int)$_POST['occupied_rooms'];
    $price_raw       = $_POST['price_per_night'];
    $price_per_night = (float)preg_replace('/[^0-9.]/', '', $price_raw);

    if ($occupied_rooms > $total_rooms) {
        $error = "Occupied rooms cannot exceed total rooms!";
    } elseif ($price_per_night < 5000) {
        $error = "Price too low! Minimum ₦5,000";
    } else {
        $image_name = $room['image'];

        // Handle image upload
        if (!empty($_FILES['room_image']['name'])) {
            $target_dir = "../images/";
            $image_name = time() . "_" . basename($_FILES["room_image"]["name"]);
            $target_file = $target_dir . $image_name;

            $allowed = ['jpg', 'jpeg', 'png', 'webp'];
            $ext = strtolower(pathinfo($_FILES["room_image"]["name"], PATHINFO_EXTENSION));

            if (!in_array($ext, $allowed)) {
                $error = "Only JPG, JPEG, PNG & WEBP allowed!";
            } elseif ($_FILES["room_image"]["size"] > 5000000) {
                $error = "Image too large! Max 5MB";
            } elseif (move_uploaded_file($_FILES["room_image"]["tmp_name"], $target_file)) {
                // Delete old image
                if ($room['image'] && $room['image'] !== 'default-suite.jpg' && file_exists("../images/" . $room['image'])) {
                    unlink("../images/" . $room['image']);
                }
            } else {
                $error = "Image upload failed!";
            }
        }

        if (!$error) {
            try {
                $stmt = $pdo->prepare("UPDATE room_inventory SET 
                    total_rooms = ?, occupied_rooms = ?, price_per_night = ?, image = ? 
                    WHERE id = ?");
                $stmt->execute([$total_rooms, $occupied_rooms, $price_per_night, $image_name, $id]);

                $success = "Room updated successfully! Redirecting...";
                echo "<script>setTimeout(() => { window.location.href = 'room_management.php'; }, 2000);</script>";
            } catch (Exception $e) {
                $error = "Failed to update room. Try again.";
            }
        }
    }
}

$current_image = $room['image'] ?? 'default-suite.jpg';
?>

