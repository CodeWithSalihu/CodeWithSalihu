Options -Indexes
RewriteEngine On

# ------------------------------------
# FORCE HTTPS + WWW
# ------------------------------------
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.degrandhotel\.com$ [NC]
RewriteRule ^ https://www.degrandhotel.com%{REQUEST_URI} [L,R=301]

# ------------------------------------
# /all/ ADMIN FOLDER — UNTOUCHED
# ------------------------------------
RewriteCond %{REQUEST_URI} ^/all/ [NC]
RewriteRule ^ - [L]

# ------------------------------------
# DO NOT TOUCH REAL FILES OR DIRECTORIES
# ------------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ------------------------------------
# REMOVE .php FROM URL (ROOT + SUBFOLDERS)
# ------------------------------------
# If requested URL is not a real file/folder, but .php exists, serve it
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)/?$ $1.php [L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
